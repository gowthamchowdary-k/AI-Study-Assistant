{
  "version": 2,
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat",
      "destination": "/api/index.py"
    },
    {
      "source": "/history",
      "destination": "/api/index.py"
    },
    {
      "source": "/upload",
      "destination": "/api/index.py"
    },
    {
      "source": "/documents",
      "destination": "/api/index.py"
    },
    {
      "source": "/documents/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/reset",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    }
  ]
}